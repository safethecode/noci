{
  "name": "noci-icons",
  "version": "0.1.0-alpha.1",
  "description": "SVG icons for web interfaces, with 16px and 24px designs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safethecode/noci.git"
  },
  "homepage": "https://github.com/safethecode/noci#readme",
  "bugs": "https://github.com/safethecode/noci/issues",
  "keywords": [
    "icons",
    "svg",
    "accessibility"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./svg/*": "./dist/svg/*",
    "./sprite/*": "./dist/sprite/*",
    "./metadata.json": "./dist/metadata.json",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "check": "npm run lint && npm run build && npm run typecheck && npm test && npm run size && npm run test:package",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:browser": "playwright test",
    "browsers:install": "node scripts/install-browsers.mjs",
    "size": "node scripts/size.mjs",
    "qa": "node scripts/visual-qa.mjs",
    "qa:marks": "node scripts/solid-mark-qa.mjs",
    "qa:openings": "node scripts/opening-qa.mjs",
    "prepack": "npm run build",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "svgpath": "2.6.0",
    "typescript": "7.0.2"
  }
}
