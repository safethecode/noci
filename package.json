{
  "name": "noci-icons",
  "version": "0.1.0-alpha.1",
  "description": "SVG icons for web interfaces, with 16px and 24px designs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safethecode/noci.git"
  },
  "homepage": "https://github.com/safethecode/noci#readme",
  "bugs": "https://github.com/safethecode/noci/issues",
  "keywords": [
    "icons",
    "svg",
    "accessibility"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "require": "./dist/icons/*.cjs"
    },
    "./svg/*": "./dist/svg/*",
    "./sprite/*": "./dist/sprite/*",
    "./metadata.json": "./dist/metadata.json",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run size && npm run test:package",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:browser": "playwright test",
    "browsers:install": "node scripts/install-browsers.mjs",
    "size": "node scripts/size.mjs",
    "qa": "node scripts/visual-qa.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
